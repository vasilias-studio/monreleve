{
  "name": "monreleve-app",
  "version": "2.0.0",
  "private": true,
  "description": "MonReleve — suivi des notes universitaires : site web HTML (rendu serveur Express + SQLite) avec API REST et vraie console admin",
  "type": "module",
  "scripts": {
    "setup": "npm install",
    "seed": "node server/seed.js",
    "seed:clean": "node server/seed.js --reset",
    "create-admin": "node server/createAdmin.js",
    "serve": "node server/index.js",
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "backup": "node tools/backup.js",
    "test:pg": "node tools/test-pg.js",
    "pg:schema": "node tools/db-setup.js schema",
    "pg:seed": "node tools/db-setup.js seed",
    "pg:check": "node tools/db-setup.js check",
    "vercel:local": "node tools/serve-vercel.js",
    "test:http": "node tools/test-http.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
