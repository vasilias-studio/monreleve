# MonRelevé — variables d'environnement (copiez ce fichier en .env.local pour vos essais)
# ---------------------------------------------------------------------------------------
# Sur Vercel, ces deux variables se définissent dans Settings → Environment Variables.

# Base de données PostgreSQL : chaîne de connexion Supabase
# (Supabase → Project Settings → Database → Connection string → « Session pooler »)
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Signature des jetons de session : chaîne aléatoire d'au moins 16 caractères
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez-moi-par-une-chaine-aleatoire

# ---------------------------------------------------------------------------------------
# Facultatif (valeurs par défaut entre parenthèses)

# Pilote de base : postgres si DATABASE_URL est définie, sinon sqlite (sqlite)
# DB_DRIVER=sqlite

# Emplacement des données locales du pilote SQLite (./data)
# DATA_DIR=/chemin/vers/donnees

# Taille maximale d'un classeur importé, en Mo (12)
# UPLOAD_MAX_MB=12

# Durée de conservation d'un classeur non importé, en heures (24)
# UPLOAD_KEEP_HOURS=24

# Nombre maximum de connexions PostgreSQL par instance (1 — adapté au sans-serveur)
# PG_POOL_MAX=1
